 void psyqo::GPU::flip() {
-    do {
+    // The deferred chain owns its packet and ordering-table storage until
+    // both GPU DMA and any scheduled OTC transfer have completed.
+    while (m_chainStatus == CHAIN_TRANSFERRING) {
         pumpCallbacks();
         eastl::atomic_signal_fence(eastl::memory_order_acquire);
-    } while ((m_previousFrameCount == m_frameCount) || (m_chainStatus == CHAIN_TRANSFERRING));
+    }
+
+    // GP0(1F) is an ordered GPU IRQ marker.  This is deliberately polled:
+    // Kernel::Internal::prepare owns the CPU IRQ table, and GPU::initialize
+    // enables VBlank and DMA only, so no other handler owns this marker.
+    constexpr uint32_t kGpuIrqMarker = 0x1F000000;
+    constexpr uint32_t kGpuIrqAcknowledge = 0x02000000;
+    constexpr uint32_t kGpuStatIrqMask = 0x01000000;
+    Hardware::GPU::Ctrl = kGpuIrqAcknowledge;
+    waitFifo();
+    sendRaw(kGpuIrqMarker);
+    const uint32_t markerStart = now();
+    while ((Hardware::GPU::Ctrl & kGpuStatIrqMask) == 0) {
+        pumpCallbacks();
+        Kernel::assert(static_cast<uint32_t>(now() - markerStart) < 500000,
+                       "PS1_GPU_COMPLETION_TIMEOUT");
+    }
+    Hardware::GPU::Ctrl = kGpuIrqAcknowledge;
+
+    // Capture the count after the ordered marker, then require a later
+    // VBlank.  An older VBlank must not satisfy a slow frame's presentation.
+    m_previousFrameCount = m_frameCount;
+    while (m_frameCount == m_previousFrameCount) {
+        pumpCallbacks();
+        eastl::atomic_signal_fence(eastl::memory_order_acquire);
+    }

     auto parity = m_parity;
