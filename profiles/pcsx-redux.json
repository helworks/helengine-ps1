{
  "project": {
    "schemaVersion": 7,
    "id": "pcsx-redux",
    "name": "PCSX-Redux",
    "description": "Read-only PCSX-Redux emulator recognition project for the helengine-ps1 PlayStation route. The real window belongs to the pcsx-redux.main child process, not the pcsx-redux.exe launcher. Running Game requires the menu bar to stay visible while emulating: gui.ShowMenu must be true in pcsx.json (%APPDATA%\\pcsx-redux\\pcsx.json); with it false the frame has no text and helenui cannot recognize it."
  },
  "surfaces": [
    {
      "id": "surface-pcsx-redux-running-game",
      "kind": "screen",
      "parentId": null,
      "name": "Running Game",
      "description": "PCSX-Redux is emulating beneath its ImGui menu bar (gui.ShowMenu = true); the idle splash text is gone.",
      "capabilities": [
        "readOnly"
      ],
      "recognition": {
        "clues": [
          {
            "id": "pcsx-redux-running-process",
            "type": "process_name_any_of",
            "weight": 1,
            "params": {
              "processNames": [
                "pcsx-redux.main",
                "pcsx-redux.exe"
              ]
            }
          },
          {
            "id": "pcsx-redux-running-no-idle-splash",
            "type": "none_of_texts",
            "weight": 1,
            "params": {
              "texts": [
                "To load a binary",
                "load a disc image",
                "Load Binary"
              ]
            }
          }
        ]
      },
      "viewports": [
        {
          "id": "game-content",
          "edges": {
            "top": {
              "kind": "after_texts",
              "texts": [
                "File",
                "Emulation",
                "Configuration",
                "Debug",
                "Help"
              ],
              "minimumMatches": 3,
              "paddingPixels": 2
            },
            "bottom": {
              "kind": "frame_end"
            },
            "left": {
              "kind": "frame_start"
            },
            "right": {
              "kind": "frame_end"
            }
          }
        }
      ],
      "uiNodes": []
    },
    {
      "id": "surface-pcsx-redux-main-menu",
      "kind": "screen",
      "parentId": null,
      "name": "Main Menu",
      "description": "PCSX-Redux is idle and showing its load-a-file splash under the menu bar.",
      "capabilities": [
        "readOnly"
      ],
      "recognition": {
        "clues": [
          {
            "id": "pcsx-redux-main-menu-process",
            "type": "process_name_any_of",
            "weight": 1,
            "params": {
              "processNames": [
                "pcsx-redux.main",
                "pcsx-redux.exe"
              ]
            }
          },
          {
            "id": "pcsx-redux-main-menu-signature",
            "type": "at_least_texts",
            "weight": 1,
            "params": {
              "texts": [
                "Idle",
                "To load a binary",
                "load a disc image",
                "Open Disk Image",
                "Load Binary"
              ],
              "minimumMatches": 2
            }
          }
        ]
      },
      "uiNodes": []
    }
  ],
  "stateTransitions": [],
