<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RunAnalyzers>false</RunAnalyzers>
    <HelengineRoot Condition="'$(HelengineRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\helengine</HelengineRoot>
    <EngineBinaryRoot Condition="'$(EngineBinaryRoot)' == '' and '$(HELENGINE_BINARY_ROOT)' != ''">$(HELENGINE_BINARY_ROOT)</EngineBinaryRoot>
    <EngineBinaryRoot Condition="'$(EngineBinaryRoot)' == ''">$(HelengineRoot)\helengine.ui\helengine.editor.app\bin\vs\Debug\net9.0-windows</EngineBinaryRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="helengine.editor" HintPath="$(EngineBinaryRoot)\helengine.editor.dll" />
    <Reference Include="helengine.files" HintPath="$(EngineBinaryRoot)\helengine.files.dll" />
    <Reference Include="helengine.core" HintPath="$(EngineBinaryRoot)\helengine.core.dll" />
    <Reference Include="helengine.baseplatform" HintPath="$(EngineBinaryRoot)\helengine.baseplatform.dll" />
    <Reference Include="helengine.shader" HintPath="$(EngineBinaryRoot)\helengine.shader.dll" />
    <Reference Include="helengine.shader.compilation" HintPath="$(EngineBinaryRoot)\helengine.shader.compilation.dll" />
  </ItemGroup>
</Project>
